<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompatActivity requires an AppCompat-derived theme; using android:Theme.Material
        here throws at startup. The visual styling is all done by Compose in StockApplicationTheme,
        so this only needs to be a valid AppCompat base.
    -->
    <style name="Theme.StockApplication" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
