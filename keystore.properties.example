# Template for local release signing.
#
# Copy this file to `keystore.properties` in the repository root and fill in
# your own values. `keystore.properties` is git-ignored and must never be
# committed, because it holds the password to the key that identifies the app
# on every device it is installed on. Losing it means you can no longer publish
# an update over an existing install, and the key cannot be changed afterwards.
#
# If `keystore.properties` is absent the release build still succeeds, but it
# produces an *unsigned* artifact. That is deliberate: a fresh clone must not
# fail to build just because it has no signing key.
#
# Generating a key:
#   keytool -genkeypair -v \
#     -keystore ~/.android-keystores/your-release.jks \
#     -alias youralias -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile may be absolute or relative to the project root.

storeFile=/absolute/path/to/your-release.jks
storePassword=changeme
keyAlias=youralias
keyPassword=changeme
